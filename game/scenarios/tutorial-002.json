      "criterion": {
        "type": "population_balance"
      }
    }
  ],
  "narrative": {
    "character": {
      "name": "You",
      "role": "Mapmaker, Millbrook County",
      "motivation": "You've got the controls down. Now the maps start to have rules. The first one every real map must follow: districts have to be about equal in population, and each one has to be a single connected piece. Let's draw a map that's actually legal.\n"
    },
    "intro_slides": [
      {
        "body": "A bigger slice of the county this time, and three districts to draw. The controls are the same as before — pick a district, paint precincts — but now a map has to be *legal*, and that means following two rules.\n",
        "heading": "Back to Millbrook — Now With Rules"
      },
      {
        "body": "First, the three districts must hold roughly equal population — and the north of the county is far more crowded than the south, so equal-sized districts on the map won't be equal in people. Second, each district must be one connected piece, not scattered fragments. The Map Validity panel on the right tracks both — even things out and keep each district whole until it's all green, then submit.\n",
        "heading": "Equal, and Connected"
      }
    ],
    "objective": "Carve Millbrook into three districts that are roughly equal in population and each a single connected piece. Watch the Map Validity panel, and submit when it's green.\n",
    "epilogue": "That's a legal map: three districts, each holding about the same number of people, each a single connected piece. Because the north is denser, equal population meant unequal area — the dense north got a smaller district, the sparse south a larger one. The Map Validity panel was your guide the whole way.\nEqual population and contiguity are the ground rules under every map from here. Next, we add the part that makes redistricting matter: how the lines you draw decide who wins — reading the vote.\n"
  },
  "default_district_id": "d1",
  "hide_election_results": true,
  "hide_view_toolbar": true,
  "guided": true
}
