# ── evaluate_test: run tests with Node ───────────────────────────────────────

js_test(
    name = "evaluate_test",
    entry_point = "evaluate_test.js",
    data = [
        ":evaluate_test_lib",
        ":evaluate_lib",
        ":validity_lib",
        ":election_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
