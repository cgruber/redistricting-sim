"""
Bazel targets for the simulation layer:

  election_lib  — election.ts (runElection function; GAME-005)
  validity_lib  — validity.ts (computeValidityStats; GAME-010)

Creating this BUILD.bazel makes src/simulation/ a separate Bazel package, so
game/web/BUILD.bazel's glob(["src/**/*.ts"]) no longer covers this directory.
game/web/BUILD.bazel lists both targets as explicit deps on app_typecheck_lib
and the esbuild app bundle.
"""

load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

# GAME-109: expose colocated test sources + BUILD to //game/web:unwired_tests_test.
filegroup(
    name = "test_sources_for_meta",
    srcs = glob(["*_test.ts"]) + ["BUILD.bazel"],
    visibility = ["//game/web:__pkg__"],
)

# GAME-107: expose lint-able sources to //game/web:lint_test (see model/BUILD.bazel).
filegroup(
    name = "lint_sources",
    srcs = glob(
        [
            "*.ts",
            "tsconfig*.json",
        ],
        allow_empty = True,
    ),
    visibility = ["//game/web:__pkg__"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//game/web/src/simulation:__pkg__"],
)

# ── election_lib: runElection ─────────────────────────────────────────────────

ts_project(
    name = "election_lib",
    srcs = ["election.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
    ],
    visibility = ["//game/web:__subpackages__"],
)

# ── validity_lib: computeValidityStats ────────────────────────────────────────

ts_project(
    name = "validity_lib",
    srcs = ["validity.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:model_lib",
    ],
    visibility = ["//game/web:__pkg__", "//game/web/src/simulation:__pkg__"],
)

# ── validity_typecheck_test: type-check passes ────────────────────────────────

build_test(
    name = "validity_typecheck_test",
    targets = [":validity_lib"],
    visibility = ["//visibility:public"],
)

# ── validity_test_lib: compile the test ───────────────────────────────────────

ts_project(
    name = "validity_test_lib",
    srcs = ["validity_test.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":validity_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
)

# ── validity_test: run tests with Node ───────────────────────────────────────

js_test(
    name = "validity_test",
    entry_point = "validity_test.js",
    data = [
        ":validity_test_lib",
        ":validity_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    node_options = [
        "--experimental-vm-modules",
    ],
    visibility = ["//visibility:public"],
)

# ── election_test_lib: compile the test ──────────────────────────────────────

ts_project(
    name = "election_test_lib",
    srcs = ["election_test.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":election_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
)

# ── election_test: run tests with Node ───────────────────────────────────────

js_test(
    name = "election_test",
    entry_point = "election_test.js",
    data = [
        ":election_test_lib",
        ":election_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    node_options = [
        "--experimental-vm-modules",
    ],
    visibility = ["//visibility:public"],
)

# ── verdict_lib: computeStarCount + computeMaxStars + buildValidityRows ────────

ts_project(
    name = "verdict_lib",
    srcs = ["verdict.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":evaluate_lib",
        ":validity_lib",
        "//game/web/src/model:model_lib",
    ],
    visibility = ["//game/web:__pkg__", "//game/web/src/simulation:__pkg__"],
)

# ── verdict_typecheck_test ────────────────────────────────────────────────────

build_test(
    name = "verdict_typecheck_test",
    targets = [":verdict_lib"],
    visibility = ["//visibility:public"],
)

# ── verdict_test_lib ──────────────────────────────────────────────────────────

ts_project(
    name = "verdict_test_lib",
    srcs = ["verdict_test.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":verdict_lib",
        ":evaluate_lib",
        ":validity_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
)

# ── verdict_test: run tests with Node ─────────────────────────────────────────

js_test(
    name = "verdict_test",
    entry_point = "verdict_test.js",
    data = [
        ":verdict_test_lib",
        ":verdict_lib",
        ":evaluate_lib",
        ":validity_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    node_options = [
        "--experimental-vm-modules",
    ],
    visibility = ["//visibility:public"],
)

# ── evaluate_lib: evaluateCriteria + isMapSubmittable ─────────────────────────

ts_project(
    name = "evaluate_lib",
    srcs = ["evaluate.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":validity_lib",
        ":election_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/model:runtime_lib",
    ],
    visibility = ["//game/web:__pkg__", "//game/web/src/simulation:__pkg__"],
)

# ── evaluate_typecheck_test ───────────────────────────────────────────────────

build_test(
    name = "evaluate_typecheck_test",
    targets = [":evaluate_lib"],
    visibility = ["//visibility:public"],
)

# ── evaluate_test_lib ─────────────────────────────────────────────────────────

ts_project(
    name = "evaluate_test_lib",
    srcs = ["evaluate_test.ts"],
    tsconfig = ":tsconfig",
    declaration = True,
    deps = [
        ":evaluate_lib",
        ":validity_lib",
        ":election_lib",
        "//game/web/src/model:runtime_lib",
        "//game/web/src/model:party_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
