        ":river_lib",
        ":terrain_generator_lib",
        ":spec_types_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
)

js_test(
    name = "river_test",
    entry_point = "river_test.js",
    data = [
        ":river_test_lib",
        ":river_lib",
        ":terrain_generator_lib",
        ":spec_types_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
