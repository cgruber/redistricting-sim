load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# tsconfig variant that emits declarations — needed for the standalone
# criterion_icons_lib so its colocated unit test can resolve "./criterion-icons.js"
# types (the root tsconfig used by the app glob does not emit .d.ts files).
ts_config(
    name = "tsconfig_lib",
    src = "tsconfig.lib.json",
    deps = [":tsconfig"],
)

# Type-check target: verifies TypeScript types without producing runtime output.
# Note: src/model/ is a separate Bazel package (owns BUILD.bazel); glob does not
# cross package boundaries, so model targets are listed explicitly as deps.
# criterion-icons.ts lives in the root game/web package (src/ root). It owns a
# dedicated ts_project/js_test pair (:criterion_icons_lib / :criterion_icons_test)
# for unit coverage (GAME-109), so it is excluded from the broad src glob here and
# in the esbuild app below to avoid two targets producing criterion-icons.js.
ts_project(
    name = "app_typecheck_lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/criterion-icons.ts",
            "src/criterion-icons_test.ts",
        ],
    ),
    tsconfig = ":tsconfig",
    deps = [
        "//game:node_modules/d3",
        "//game:node_modules/@types/d3",
        "//game:node_modules/zustand",
        "//game:node_modules/zundo",
        "//game/web/src/model:loader_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/model:types_lib",
        "//game/web/src/model:hex_geometry_lib",
        "//game/web/src/model:adapter_lib",
        "//game/web/src/model:progress_lib",
        "//game/web/src/model:campaigns_lib",
        "//game/web/src/model:escape_html_lib",
        "//game/web/src/simulation:election_lib",
        "//game/web/src/simulation:validity_lib",
        "//game/web/src/simulation:evaluate_lib",
        "//game/web/src/simulation:verdict_lib",
        "//game/web/src/store:gameStore_lib",
        "//game/web/src/audio:audioplayer_lib",
        ":criterion_icons_lib",
    ],
)

# build_test: confirms type checking passes under bazel test //...
build_test(
    name = "app_typecheck_test",
    targets = [":app_typecheck_lib"],
    visibility = ["//visibility:public"],
)

# esbuild bundles TypeScript + npm deps into a single browser-ready JS file.
# Note: src/model/ is a separate Bazel package; model sources are provided via
# deps on //web/src/model targets.
esbuild(
    name = "app",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/criterion-icons.ts",
            "src/criterion-icons_test.ts",
        ],
    ),
    entry_point = "src/main.ts",
    deps = [
        "//game:node_modules/d3",
        "//game:node_modules/zustand",
        "//game:node_modules/zundo",
        "//game/web/src/model:loader_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/model:types_lib",
        "//game/web/src/model:hex_geometry_lib",
        "//game/web/src/model:adapter_lib",
        "//game/web/src/model:progress_lib",
        "//game/web/src/model:campaigns_lib",
        "//game/web/src/model:escape_html_lib",
        "//game/web/src/simulation:election_lib",
        "//game/web/src/simulation:validity_lib",
        "//game/web/src/simulation:evaluate_lib",
        "//game/web/src/simulation:verdict_lib",
        "//game/web/src/store:gameStore_lib",
        "//game/web/src/audio:audioplayer_lib",
        ":criterion_icons_lib",
    ],
    output = "bundle.js",
    format = "esm",
    # Mark react as external: zustand ships React bindings that are not used here
    # (we use zustand/vanilla). The bazel-sandbox plugin would fail trying to bundle
    # react since it is not a declared dependency.
    external = ["react", "react-dom"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "html",
    srcs = ["index.html", "styles.css", "react-stub.js"],
    visibility = ["//visibility:public"],
)

# ── criterion_icons_lib: per-criterion result-screen SVG icons (GAME-066) ─────
#
# criterion-icons.ts lives at the src/ root of this package. It is excluded from
# the broad app glob (above) and given a dedicated ts_project so it can be
# unit-tested (GAME-109) without a second target producing criterion-icons.js.
ts_project(
    name = "criterion_icons_lib",
    srcs = ["src/criterion-icons.ts"],
    tsconfig = ":tsconfig_lib",
    declaration = True,
    deps = ["//game/web/src/model:model_lib"],
    visibility = ["//game/web:__subpackages__"],
)

# ── criterion_icons_test_lib: compile the icon tests ──────────────────────────

ts_project(
    name = "criterion_icons_test_lib",
    srcs = ["src/criterion-icons_test.ts"],
    tsconfig = ":tsconfig_lib",
    declaration = True,
    deps = [
        ":criterion_icons_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    testonly = True,
)

# ── criterion_icons_test: run the icon tests with Node ────────────────────────

js_test(
    name = "criterion_icons_test",
    entry_point = "src/criterion-icons_test.js",
    data = [
        ":criterion_icons_test_lib",
        ":criterion_icons_lib",
        "//game/web/src/model:model_lib",
        "//game/web/src/testing:test_runner_lib",
    ],
    node_options = [
        "--experimental-vm-modules",
    ],
    visibility = ["//visibility:public"],
)

# Static asset files (character SVGs, audio clips) served under /assets/.
# Populated incrementally by GAME-060 (sprites) and GAME-061 (audio).
#
# NOTE: asset_files globs assets/**/* and the deployable genrule uses
# cp -r to copy the whole assets tree, so new subdirectories are picked up
# automatically — no changes to BUILD.bazel required when adding new subdirs.
filegroup(
    name = "asset_files",
    srcs = glob(
        ["assets/**/*"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Playwright behavioral (e2e) smoke test — CI-002 Phase 1.
#
# Assembles Bazel-built artifacts into a temp dir, starts python3 http.server
# on port 58173, and runs pnpm exec playwright test against it.
#
# local = True: Playwright requires a Chromium browser binary installed
# outside the Bazel sandbox. Run `./setup.sh` once per machine to install
# node_modules and download the managed Playwright Chromium.
#
# One-time setup outside Bazel:
#   cd game && ./setup.sh
sh_test(
    name = "e2e_test",
    srcs = ["e2e_test.sh"],
    data = [
        ":app",
        ":html",
        ":asset_files",
        "//game/rust:wasm_calc_bindgen",
        "//game/scenarios:scenario_files",
        "playwright.config.ts",
        "e2e/smoke.spec.ts",
        "e2e/sprint1.spec.ts",
        "e2e/sprint2.spec.ts",
        "e2e/sprint3.spec.ts",
        "e2e/sprint4.spec.ts",
        "e2e/scenarios.spec.ts",
        "e2e/main-menu.spec.ts",
        "e2e/campaign-select.spec.ts",
        "e2e/a11y.spec.ts",
        "e2e/submit-on-invalid.spec.ts",
        "e2e/sprint5.spec.ts",
        # Playwright packages as declared Bazel deps — ensures the cache key includes
        # the playwright version and the files are available in runfiles.
        "//game:node_modules/@playwright/test",
    ],
    local = True,
    tags = [
        "no-sandbox",
        "e2e",
    ],
    visibility = ["//visibility:public"],
)

# Biome lint + format gate — GAME-107.
#
# Runs `biome ci .` (no-write CI mode: format + enabled lint rules) over the
# game/web source tree and fails on any violation. The formatter config matches
# the existing house style (tab indent, double quotes, semicolons, trailing
# commas, lineWidth 100) so the gate enforces format + a baseline lint set; the
# noisy intentional-pattern rules (noNonNullAssertion, useLiteralKeys, …) are
# deferred in biome.jsonc with TODO GAME-107 notes.
#
# Mirrors e2e_test: local = True + no-sandbox, and invokes the PHYSICAL
# node_modules/.bin/biome binary (installed by ./setup.sh via npm ci) the same
# way e2e_test runs node_modules/.bin/playwright. There is no
# //game:node_modules/@biomejs/biome Bazel target because the Bazel npm repo is
# translated from pnpm-lock.yaml (which lags package-lock.json — see setup.sh),
# so we cannot declare biome as a //game:node_modules dep like playwright. The
# binary is resolved at runtime from the workspace node_modules.
#
# data: ALL linted files must be declared so editing in a violation invalidates
# the cache and re-runs the gate. glob does not cross package boundaries, so each
# subpackage surfaces its sources via a :lint_sources filegroup.
#
# One-time setup outside Bazel:
#   cd game && ./setup.sh
sh_test(
    name = "lint_test",
    srcs = ["lint_test.sh"],
    data = [
        "biome.jsonc",
        "tsconfig.json",
        "tsconfig.lib.json",
        "playwright.config.ts",
        "//game/web/src/model:lint_sources",
        "//game/web/src/simulation:lint_sources",
        "//game/web/src/pipeline:lint_sources",
        "//game/web/src/store:lint_sources",
        "//game/web/src/audio:lint_sources",
        "//game/web/src/testing:lint_sources",
    ] + glob([
        # Root-package sources biome lints (render/ and tutorial/ are NOT separate
        # Bazel packages, so this glob reaches them). Subpackage sources come via
        # the :lint_sources filegroups above (glob stops at package boundaries).
        "src/**/*.ts",
        # e2e specs are also linted by `biome ci .` and have no BUILD.bazel, so this
        # glob reaches them directly — they must be data deps or a violation there
        # would not invalidate the gate's cache (silent stale PASS).
        "e2e/**/*.ts",
    ]),
    local = True,
    tags = [
        "no-sandbox",
        "lint",
    ],
    visibility = ["//visibility:public"],
)

# Meta-test (GAME-111): keep the lint gate's per-subpackage coverage from eroding.
# Every game/web/src subpackage surfaces its sources to lint_test via a :lint_sources
# filegroup (glob stops at package boundaries). A new subpackage that forgets to add
# one would be unlinted, and its violations wouldn't invalidate the gate's cache
# (silent stale PASS). This test asserts that every subpackage the unwired-tests
# backstop already enumerates (via :test_sources_for_meta) is ALSO wired into
# lint_test (via :lint_sources) — so the two enumerations can't drift apart.
#
# LIMIT (irreducible): a brand-new subpackage referenced by NEITHER backstop is
# invisible to both — Bazel can't enumerate an un-referenced package from a hermetic
# test (genquery `scope` rejects `//game/web/src/...`). The per-package filegroup
# convention + code review remain the first line; this guards the common drift
# (added a subpackage, wired its tests, forgot lint).
sh_test(
    name = "lint_coverage_test",
    srcs = ["lint_coverage_test.sh"],
    data = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

# Meta-test (GAME-109): fail when a colocated `src/**/*_test.ts` has no
# corresponding js_test target. A backstop for the explicit per-target
# convention — a new test file the author forgets to wire would otherwise
# compile into nothing and never run while `bazel test //...` stays green.
#
# `data` must reach every test source AND every BUILD.bazel: glob does not cross
# package boundaries, so each subpackage surfaces its files via a
# :test_sources_for_meta filegroup. The root package's own test sources (e.g.
# criterion-icons_test.ts) and this BUILD.bazel are added directly.
sh_test(
    name = "unwired_tests_test",
    srcs = ["unwired_tests_test.sh"],
    data = [
        "BUILD.bazel",
        "//game/web/src/model:test_sources_for_meta",
        "//game/web/src/simulation:test_sources_for_meta",
        "//game/web/src/store:test_sources_for_meta",
        "//game/web/src/audio:test_sources_for_meta",
        "//game/web/src/pipeline:test_sources_for_meta",
    ] + glob(["src/*_test.ts"]),
    visibility = ["//visibility:public"],
)

# GAME-108 CI guard: the deploy (game/release.main.kts) patches index.html by exact-string
# replacement against fixed anchors. release.main.kts is NOT exercised by `bazel test`, so a
# reformat that breaks an anchor would only surface at deploy time. This test fails CI if any
# anchor is gone from index.html. See release_patch_anchors_test.sh for the literals (kept in
# sync with the .replace(...) anchors in release.main.kts).
sh_test(
    name = "release_patch_anchors_test",
    srcs = ["release_patch_anchors_test.sh"],
    data = ["index.html"],
    visibility = ["//visibility:public"],
)

# Deployable package: bundles all game assets (HTML, CSS, JS, WASM, scenarios)
# into a single zip file ready for static hosting.
#
# Usage:
#   bazel build //web:deployable
#   unzip bazel-bin/web/deployable.zip -d /path/to/deploy
genrule(
    name = "deployable",
    srcs = [
        ":app",
        ":html",
        ":asset_files",
        "//game/rust:wasm_calc_bindgen",
        "//game/scenarios:scenario_files",
    ],
    outs = ["deployable.zip"],
    cmd = """
        set -euo pipefail

        # Create staging directory
        STAGING="$$(mktemp -d)"
        trap "rm -rf $$STAGING" EXIT

        # Iterate over all source files and copy to appropriate location.
        # Assets are handled separately below via cp -r to preserve tree structure.
        ASSETS_SRC=""
        for f in $(SRCS); do
            # Skip files under the assets tree here — the dedicated `cp -r` below copies
            # the whole assets tree, preserving structure. Without this guard a future
            # assets/*.json (sprite atlas, config) would be misfiled into scenarios/, and
            # an assets/*.wasm into the root, by the basename case. (GAME-108)
            case "$$f" in
                */assets/*)
                    ASSETS_SRC="$${f%/assets/*}/assets"
                    ;;
                *)
                    fname="$$(basename "$$f")"
                    case "$$fname" in
                        index.html) cp "$$f" "$$STAGING/" ;;
                        styles.css) cp "$$f" "$$STAGING/" ;;
                        react-stub.js) cp "$$f" "$$STAGING/" ;;
                        bundle.js) cp "$$f" "$$STAGING/" ;;
                        *.wasm) cp "$$f" "$$STAGING/" ;;
                        wasm_calc_bindgen.js) cp "$$f" "$$STAGING/" ;;
                        *.json) mkdir -p "$$STAGING/scenarios" && cp "$$f" "$$STAGING/scenarios/" ;;
                    esac
                    ;;
            esac
        done

        # Copy entire assets tree in one shot to preserve subdirectory structure,
        # matching the behaviour of serve.sh and e2e_test.sh.
        if [[ -n "$$ASSETS_SRC" ]]; then
            mkdir -p "$$STAGING/assets"
            cp -r "$$ASSETS_SRC/." "$$STAGING/assets/"
        fi

        # Create zip file
        cd "$$STAGING"
        zip -q -r "$$OLDPWD/$(location deployable.zip)" .
    """,
    visibility = ["//visibility:public"],
)
