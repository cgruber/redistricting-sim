load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Link all npm packages into //:node_modules — required for ts_project deps.
npm_link_all_packages(name = "node_modules")

sh_binary(
    name = "serve",
    srcs = [":serve.sh"],
    data = [
        "//game/rust:wasm_calc_bindgen",
        "//game/web:app",
        "//game/web:html",
    ],
)

# Local serve via the deployable zip — matches exactly what ships.
# Usage: bazel run //game:serve-local
# For standalone (no bazel run): ./release.main.kts -- serve
sh_binary(
    name = "serve-local",
    srcs = [":serve-local.sh"],
    data = ["//game/web:deployable"],
)
